# PBL4 System Environment Variables
# Copy this file to .env and update with your local values

# ============================================
# Backend Configuration (Spring Boot)
# ============================================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/pbl4_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true

# AI Service URL - Backend calls this to process images
AI_SERVICE_URL=http://localhost:8000

# ============================================
# AI Service Configuration (FastAPI)
# ============================================
PYTHON_ENV=development

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================
# Frontend Configuration (Next.js)
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=PBL4 Scan System
NEXT_PUBLIC_APP_VERSION=1.0.0

